# Copy to .env.local (gitignored) and fill in. None of these are secrets: the Firebase web config and the
# VAPID *public* key are public by design. Never put the VAPID private key here (it is a Worker secret).
# Every value is optional: the app falls back to the defaults in src/firebaseConfig.js.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# The two Google accounts allowed in (lowercase)
VITE_PERSON_A_EMAIL=
VITE_PERSON_B_EMAIL=
# Database roots (leave unset to keep the defaults; only change them to point at a differently named tree)
# VITE_DB_ROOT=trailhead-tracker-v1
# VITE_MESSAGES_ROOT=trailhead-tracker-v1-messages
# Web Push: base64url VAPID public key and the deployed Cloudflare Worker base URL (no trailing path)
VITE_VAPID_PUBLIC_KEY=
VITE_PUSH_URL=
